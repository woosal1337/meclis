# Anthropic API key — required.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Server port (frontend assumes 3001)
PORT=3001

# Where to read advisor character packs from.
# Default points at the council skill installation.
ADVISOR_DIR=~/.claude/skills/council/advisors

# Defaults — can be overridden per-request from the UI.
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_ROUNDS=2
DEFAULT_THINKING_BUDGET=4096
MAX_OUTPUT_TOKENS=2048
