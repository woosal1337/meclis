{
  "name": "meclis",
  "version": "0.1.0",
  "private": true,
  "description": "A 2D pixel-art viewer for Claude Code's /meclis skill. Watch your AI advisors deliberate as characters on a stage.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/woosal1337/meclis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woosal1337/meclis.git"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @meclis/web dev",
    "dev:server": "bun run --filter @meclis/server dev",
    "dev:site": "bun run --filter @meclis/site dev",
    "build": "bun run --filter '*' build",
    "build:site": "bun run --filter @meclis/site build",
    "typecheck": "bun run --filter '*' typecheck",
    "install-hooks": "node scripts/install-hooks.mjs",
    "validate-collection": "bun run scripts/validate-collection.ts",
    "generate-thumbs": "bun run scripts/generate-thumbs.ts",
    "build-collection-index": "bun run scripts/build-collection-index.ts",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/.next packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
