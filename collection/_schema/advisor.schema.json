{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meclis.chele.bi/_schema/advisor.schema.json",
  "title": "Meclis advisor descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "displayName", "brief", "tags", "version"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-safe identifier. Must equal the folder name."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Human name. Must equal the H1 of advisor.md."
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "description": "Short aliases recognized by the skill and CLI (e.g. pg, paul)."
    },
    "brief": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One-sentence pitch. Shown on cards and OG previews."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "description": "Discoverability tags: domains the advisor speaks to."
    },
    "era": {
      "type": "string",
      "description": "Lifespan or epoch hint, e.g. '1964-present', '4th c. BCE'."
    },
    "discipline": {
      "type": "string",
      "description": "Primary discipline, e.g. 'essayist', 'strategist', 'marketer'."
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "kind": {
            "type": "string",
            "enum": ["essay", "book", "podcast", "interview", "lecture", "thread", "other"]
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the pack. Bump on substantive edits."
    }
  }
}
